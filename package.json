{
  "name": "ojo-plugin",
  "displayName": "ojo-plugin",
  "description": "A VS Code extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCommand:ojo-plugin.openWeb"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "externalUriOpener"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ojo-plugin.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ojo-plugin.openWeb",
        "title": "Ojo: Open Project (Built-in Browser)",
        "icon": {
          "light": "media/ojo.svg",
          "dark": "media/ojo.svg"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ojo-plugin",
          "title": "Ojo",
          "icon": "media/ojo.svg"
        }
      ]
    },
    "views": {
      "ojo-plugin": [
        {
          "id": "ojo-plugin.projectsView",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ojo-plugin.projectsView",
        "contents": "点击 Activity Bar 的 Ojo 图标会弹出项目选择器。\\n[打开项目](command:ojo-plugin.openWeb)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ojo-plugin.openWeb",
          "when": "view == ojo-plugin.projectsView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ojo Plugin",
      "properties": {
        "ojoPlugin.serverPort": {
          "type": "number",
          "default": 37123,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local HTTP server port started when the extension activates."
        },
        "ojoPlugin.accountApiBaseUrl": {
          "type": "string",
          "default": "https://ojo.art",
          "description": "Base URL of the account API service used for create_ide_handoff."
        },
        "ojoPlugin.webBaseUrl": {
          "type": "string",
          "default": "https://ojo.art",
          "description": "Base URL of the web app."
        },
        "ojoPlugin.webTargetPath": {
          "type": "string",
          "default": "/p/4f7f14a3-3f80-48cc-a142-0af392ee0688",
          "description": "Default web path to open when triggering web login sync."
        },
        "ojoPlugin.loginBridgePath": {
          "type": "string",
          "default": "/login/ide/handoff",
          "description": "Web login bridge path that consumes the handoff ticket."
        },
        "ojoPlugin.productUriGlobs": {
          "type": "array",
          "default": [
            "https://aneway.ai/**",
            "https://*.aneway.ai/**",
            "https://ojo.art/**",
            "http://ojo.art/**",
            "https://www.baidu.com/**",
            "http://www.baidu.com/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "URI glob patterns that should open in the IDE built-in browser."
        },
        "ojoPlugin.syncCliCommand": {
          "type": "string",
          "default": "ojo",
          "description": "CLI command used for workspace sync."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
